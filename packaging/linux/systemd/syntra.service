[Unit]
Description=Syntra background service
# The service belongs to the user manager, not to a graphical session: a
# machine logged out of its desktop (a Steam Deck in game mode, a box nobody
# sits at) must stay controllable. uinput emulation needs no session; backends
# that do fail until one exists, and syntra-session.service restarts the daemon
# when a session appears.
After=graphical-session.target xdg-desktop-portal.service
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/syntra-daemon
Restart=on-failure
RestartSec=5s
# SIGINT and SIGTERM both release held keys before exit.
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
