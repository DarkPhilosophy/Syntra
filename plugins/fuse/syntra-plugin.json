{
  "$schema": "../manifest.schema.json",
  "manifest_version": 1,
  "protocol_version": 1,
  "id": "fuse",
  "name": "Read-only Clipboard FUSE",
  "executable": "syntra-plugin-fuse",
  "capabilities": {
    "clipboard_read": true,
    "paste": true,
    "cancel": true,
    "mime_types": ["text/uri-list", "x-special/gnome-copied-files"],
    "requires_live_mount": true
  }
}
