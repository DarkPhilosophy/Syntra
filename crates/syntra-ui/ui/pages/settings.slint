import { ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppButton, AppSwitch } from "../components/controls.slint";
import { ColorPicker } from "../components/color-picker.slint";
import { Translations } from "../localization.slint";
import { ServiceControls } from "../components/service-controls.slint";
import { UpdateControls } from "../components/update-controls.slint";
import { FileReceiveSettingsControls } from "../components/file-receive-settings.slint";

export component SettingsPage inherits Rectangle {
    in property <bool> mobile;
    callback navigate(string);
    in property <string> locale;
    in property <[string]> locale-options;
    in property <bool> language-import-supported;
    in property <string> base-mode;
    in property <string> palette;
    in property <string> density;
    in property <bool> reduced-motion;
    in property <bool> suppress-popups;
    callback change-suppress-popups(bool);
    in property <int> zoom-percent: 100;
    in property <bool> service-supported;
    in property <bool> service-busy;
    in property <bool> service-known;
    in property <bool> service-installed;
    in property <bool> service-running;
    in property <bool> service-autostart;
    in property <bool> backend-connected;
    in property <string> service-error;
    in property <string> service-source-path;
    in property <string> service-install-destination;
    in property <bool> service-destination-customised;
    callback choose-install-destination();
    callback reset-install-destination();
    in property <string> port;
    in property <string> status-message;
    in property <string> update-repository;
    in property <bool> update-automatic-check;
    in property <bool> update-busy;
    in property <string> update-status;
    in property <bool> file-receive-known;
    in property <bool> file-receive-busy;
    in property <bool> file-receive-picker-busy;
    in property <string> file-receive-error;
    in-out property <bool> file-auto-accept;
    in-out property <string> download-directory;
    in-out property <bool> file-receive-dirty;
    callback choose-download-directory();
    callback save-file-receive-settings();
    callback configure-updates(string);
    callback set-automatic-update-check(bool);
    callback check-updates();
    callback locale-changed(string);
    callback import-language();
    callback change-base-mode(string);
    callback change-palette(string);
    callback change-accent-color(color);
    callback change-titlebar-color-value(color);
    callback reset-accent();
    callback reset-titlebar();
    callback change-density(string);
    callback change-reduced-motion(bool);
    callback change-zoom(int);
    in property <bool> desktop-entry-supported;
    in property <bool> desktop-entry-installed;
    callback service-action(string);
    callback port-changed(string);
    private property <string> draft-port: root.port;
    function commit-port() {
        if root.draft-port != root.port && root.draft-port.to-float() >= 1 && root.draft-port.to-float() <= 65535 {
            root.port-changed(root.draft-port);
        }
    }
    private property <[string]> palette-ids: ["army", "forest", "ocean", "slate", "sand", "graphite", "aubergine", "copper", "rose", "ice"];
    background: Theme.background;

    if root.mobile: ScrollView {
        mouse-drag-pan-enabled: true;
        // Phones scroll vertically only: pin the content to the screen width.
        viewport-width: self.visible-width;
        VerticalLayout {
            width: root.width;
            padding: Theme.spacing;
            spacing: Theme.small-spacing;
            alignment: start;
            Text { text: Translations.tr("settings-section-pages"); color: Theme.muted-text; font-size: Theme.caption-size; vertical-stretch: 0; }
            for entry in [
                { id: "history", icon: @image-url("../assets/navigation/history.svg"), label: Translations.tr("history-title") },
                { id: "authorization", icon: @image-url("../assets/navigation/authorization.svg"), label: Translations.tr("navigation-authorization") },
                { id: "input", icon: @image-url("../assets/navigation/input.svg"), label: Translations.tr("navigation-input") },
                { id: "diagnostics", icon: @image-url("../assets/navigation/diagnostics.svg"), label: Translations.tr("navigation-diagnostics") },
                { id: "about", icon: @image-url("../assets/navigation/about.svg"), label: Translations.tr("navigation-about") },
            ]: Rectangle {
                height: 50px; background: Theme.surface; border-radius: Theme.small-radius;
                accessible-role: button; accessible-label: entry.label; accessible-action-default => { root.navigate(entry.id); }
                HorizontalLayout { padding-left: Theme.spacing; padding-right: Theme.spacing; spacing: Theme.spacing;
                    Image { source: entry.icon; colorize: Theme.accent; width: 22px; height: 22px; y: (parent.height - self.height) / 2; }
                    Text { text: entry.label; color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: "›"; color: Theme.muted-text; font-size: 24px; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.navigate(entry.id); } }
            }
            if Theme.desktop-platform: Rectangle { height: 50px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding-left: Theme.spacing; padding-right: Theme.spacing; spacing: Theme.spacing;
                    Image { source: @image-url("../assets/navigation/plugins.svg"); colorize: Theme.accent; width: 22px; height: 22px; y: (parent.height - self.height) / 2; }
                    Text { text: Translations.tr("navigation-plugins"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: "›"; color: Theme.muted-text; font-size: 24px; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.navigate("plugins"); } }
            }
            Text { text: Translations.tr("manual-transfer-settings-title"); color: Theme.muted-text; font-size: Theme.caption-size; vertical-stretch: 0; }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("manual-transfer-auto-accept"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    AppSwitch { checked: root.file-auto-accept; enabled: root.file-receive-known && !root.file-receive-busy; a11y-label: Translations.tr("manual-transfer-auto-accept"); toggled(value) => { root.file-auto-accept = value; root.file-receive-dirty = true; root.save-file-receive-settings(); } }
                }
            }
            Rectangle { height: 92px; background: Theme.surface; border-radius: Theme.small-radius;
                VerticalLayout { padding: Theme.small-spacing; spacing: Theme.small-spacing;
                    Text { text: Translations.tr("manual-transfer-save-folder"); color: Theme.text; font-size: Theme.body-size; vertical-stretch: 0; }
                    HorizontalLayout { spacing: Theme.small-spacing;
                        LineEdit { text <=> root.download-directory; horizontal-stretch: 1; enabled: root.file-receive-known && !root.file-receive-busy && !root.file-receive-picker-busy; edited(value) => { root.file-receive-dirty = true; } accepted => { root.save-file-receive-settings(); } }
                        AppButton { text: Translations.tr("manual-transfer-browse"); enabled: root.file-receive-known && !root.file-receive-busy && !root.file-receive-picker-busy; clicked => { root.choose-download-directory(); } }
                    }
                }
            }
            if root.file-receive-error != "": Text { text: root.file-receive-error; color: Theme.danger; font-size: Theme.caption-size; wrap: word-wrap; vertical-stretch: 0; }
            if !root.file-receive-known && root.file-receive-error == "": Text { text: Translations.tr("manual-transfer-service-offline"); color: Theme.warning; font-size: Theme.caption-size; vertical-stretch: 0; }
            if root.file-receive-dirty: AppButton { text: Translations.tr("manual-transfer-unsaved"); enabled: root.file-receive-known && !root.file-receive-busy && root.download-directory != ""; clicked => { root.save-file-receive-settings(); } }
            Text { text: Translations.tr("settings-section-general"); color: Theme.muted-text; font-size: Theme.caption-size; vertical-stretch: 0; }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-suppress-popups"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    AppSwitch { checked: root.suppress-popups; a11y-label: Translations.tr("settings-suppress-popups"); toggled(value) => { root.change-suppress-popups(value); } }
                }
            }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-base-mode"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    AppSwitch { checked: root.base-mode == "black"; a11y-label: Translations.tr("settings-base-mode"); toggled(dark) => { root.change-base-mode(dark ? "black" : "white"); } }
                }
            }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-reduced-motion"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    AppSwitch { checked: root.reduced-motion; a11y-label: Translations.tr("settings-reduced-motion-label"); toggled(value) => { root.change-reduced-motion(value); } }
                }
            }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-locale"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    ComboBox { model: root.locale-options; current-value: root.locale; selected(value) => { root.locale-changed(value); } }
                }
            }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-palette"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    ComboBox { model: [Translations.tr("palette-army"), Translations.tr("palette-forest"), Translations.tr("palette-ocean"), Translations.tr("palette-slate"), Translations.tr("palette-sand"), Translations.tr("palette-graphite"), Translations.tr("palette-aubergine"), Translations.tr("palette-copper"), Translations.tr("palette-rose"), Translations.tr("palette-ice")]; current-value: Translations.tr("palette-" + root.palette); selected(value) => { root.change-palette(root.palette-ids[self.current-index]); } }
                }
            }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-density"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    ComboBox { model: [Translations.tr("settings-comfortable"), Translations.tr("settings-compact")]; current-index: root.density == "compact" ? 1 : 0; selected(value) => { root.change-density(self.current-index == 1 ? "compact" : "comfortable"); } }
                }
            }
            Rectangle { height: 52px; background: Theme.surface; border-radius: Theme.small-radius;
                HorizontalLayout { padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-listen-port"); color: Theme.text; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    LineEdit { width: 90px; text <=> root.draft-port; input-type: number; changed has-focus => { if !self.has-focus { root.commit-port(); } } accepted => { root.commit-port(); } }
                }
            }
            if root.status-message != "": Text { text: root.status-message; color: Theme.muted-text; font-size: Theme.body-size; wrap: word-wrap; vertical-stretch: 0; }
        }
    }
    if !root.mobile: ScrollView {
        mouse-drag-pan-enabled: Theme.touch-input-active || !Theme.desktop-platform;
        viewport-width: self.visible-width;
        VerticalLayout {
            // Fit the page to the window: without this the content takes its
            // preferred width and runs off the right edge on narrow screens.
            width: root.width;
            padding: Theme.content-gap; spacing: Theme.spacing; alignment: start;
            Text { text: Translations.tr("navigation-settings"); color: Theme.text; font-size: Theme.title-size; vertical-stretch: 0; }
            HorizontalLayout {
                Text { text: Translations.tr("settings-suppress-popups"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; wrap: word-wrap; }
                AppSwitch { checked: root.suppress-popups; a11y-label: Translations.tr("settings-suppress-popups"); toggled(value) => { root.change-suppress-popups(value); } }
            }
            FileReceiveSettingsControls {
                known: root.file-receive-known;
                busy: root.file-receive-busy;
                picker-busy: root.file-receive-picker-busy;
                error-message: root.file-receive-error;
                auto-accept <=> root.file-auto-accept;
                directory <=> root.download-directory;
                dirty <=> root.file-receive-dirty;
                choose-directory => { root.choose-download-directory(); }
                save => { root.save-file-receive-settings(); }
            }
            Rectangle {
                height: language-content.preferred-height; vertical-stretch: 0;
                background: Theme.surface; border-radius: Theme.corner-radius;
                language-content := HorizontalLayout {
                    padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-locale"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; vertical-alignment: center; }
                    ComboBox { model: root.locale-options; current-value: root.locale; selected(value) => { root.locale-changed(value); } }
                    AppButton { text: Translations.tr("language-import"); enabled: root.language-import-supported; clicked => { root.import-language(); } }
                }
            }
            Rectangle {
                height: appearance-content.preferred-height; vertical-stretch: 0;
                background: Theme.surface; border-radius: Theme.corner-radius;
                appearance-content := VerticalLayout {
                    padding: Theme.spacing; spacing: Theme.spacing;
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        Text { text: Translations.tr("settings-base-mode"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: Translations.tr("settings-white"); color: Theme.muted-text; font-size: Theme.caption-size; vertical-alignment: center; }
                        AppSwitch { checked: root.base-mode == "black"; a11y-label: Translations.tr("settings-base-mode"); toggled(dark) => { root.change-base-mode(dark ? "black" : "white"); } }
                        Text { text: Translations.tr("settings-black"); color: Theme.muted-text; font-size: Theme.caption-size; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        Text { text: Translations.tr("settings-palette"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; vertical-alignment: center; }
                        ComboBox {
                            model: [Translations.tr("palette-army"), Translations.tr("palette-forest"), Translations.tr("palette-ocean"), Translations.tr("palette-slate"), Translations.tr("palette-sand"), Translations.tr("palette-graphite"), Translations.tr("palette-aubergine"), Translations.tr("palette-copper"), Translations.tr("palette-rose"), Translations.tr("palette-ice")];
                            current-value: Translations.tr("palette-" + root.palette);
                            selected(value) => { root.change-palette(root.palette-ids[self.current-index]); }
                        }
                    }
                    ColorPicker { label: Translations.tr("settings-accent"); value: Theme.accent; selected(value) => { root.change-accent-color(value); } reset => { root.reset-accent(); } }
                    ColorPicker { label: Translations.tr("settings-titlebar-color"); value: Theme.titlebar; selected(value) => { root.change-titlebar-color-value(value); } reset => { root.reset-titlebar(); } }
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        Text { text: Translations.tr("settings-density"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; vertical-alignment: center; }
                        ComboBox { model: [Translations.tr("settings-comfortable"), Translations.tr("settings-compact")]; current-index: root.density == "compact" ? 1 : 0; selected(value) => { root.change-density(self.current-index == 1 ? "compact" : "comfortable"); } }
                    }
                    HorizontalLayout {
                        Text { text: Translations.tr("settings-reduced-motion"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; vertical-alignment: center; }
                        AppSwitch { checked: root.reduced-motion; a11y-label: Translations.tr("settings-reduced-motion-label"); toggled(value) => { root.change-reduced-motion(value); } }
                    }
                    HorizontalLayout {
                        Text { text: Translations.tr("settings-zoom"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; }
                        Text { text: "\{root.zoom-percent}%"; color: Theme.muted-text; font-size: Theme.body-size; }
                    }
                    Slider { minimum: 75; maximum: 200; value: root.zoom-percent; changed(value) => { root.change-zoom(round(value)); } }
                }
            }
            if Theme.desktop-platform: ServiceControls {
                supported: root.service-supported; busy: root.service-busy; known: root.service-known;
                installed: root.service-installed; running: root.service-running; autostart: root.service-autostart;
                connected: root.backend-connected; error: root.service-error;
                source-path: root.service-source-path;
                destination-customised: root.service-destination-customised;
                choose-destination => { root.choose-install-destination(); }
                reset-destination => { root.reset-install-destination(); } destination-path: root.service-install-destination;
                desktop-entry-supported: root.desktop-entry-supported;
                desktop-entry-installed: root.desktop-entry-installed;
                action(value) => { root.service-action(value); }
            }
            if Theme.desktop-platform: UpdateControls {
                repository: root.update-repository;
                automatic-check: root.update-automatic-check;
                busy: root.update-busy;
                status: root.update-status;
                configure(value) => { root.configure-updates(value); }
                automatic-check-changed(value) => { root.set-automatic-update-check(value); }
                check => { root.check-updates(); }
            }
            Rectangle {
                height: network-content.preferred-height; vertical-stretch: 0;
                background: Theme.surface; border-radius: Theme.corner-radius;
                network-content := HorizontalLayout {
                    padding: Theme.spacing; spacing: Theme.spacing;
                    Text { text: Translations.tr("settings-listen-port"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; vertical-alignment: center; }
                    LineEdit {
                        width: 100px; text <=> root.draft-port; input-type: number;
                        changed has-focus => { if !self.has-focus { root.commit-port(); } }
                        accepted => { root.commit-port(); }
                    }
                }
            }
            if root.status-message != "": Text { text: root.status-message; color: Theme.muted-text; font-size: Theme.body-size; wrap: word-wrap; vertical-stretch: 0; }
        }
    }
}
