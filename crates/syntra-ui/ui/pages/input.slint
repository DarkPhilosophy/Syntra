import { Theme } from "../theme.slint";
import { Translations } from "../localization.slint";
import { AppButton } from "../components/controls.slint";
import { SettingRow } from "../components/setting-row.slint";
import { PageScroll } from "../components/page-scroll.slint";

/// Pick a backend or leave it automatic. Takes effect at once.
component BackendChoice inherits Rectangle {
    in property <string> title;
    in property <[string]> backends;
    in property <string> choice;
    callback changed(string);
    height: column.preferred-height;
    vertical-stretch: 0;
    background: Theme.surface;
    border-radius: Theme.small-radius;
    column := VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.small-spacing;
        Text { text: root.title; color: Theme.text; font-size: Theme.body-size; wrap: word-wrap; }
        // The chosen one is highlighted.
        HorizontalLayout {
            spacing: Theme.small-spacing;
            alignment: start;
            AppButton {
                text: Translations.tr("input-backend-automatic");
                primary: root.choice == "";
                clicked => { root.changed(""); }
            }
            for name in root.backends: AppButton {
                text: name;
                primary: root.choice == name;
                clicked => { root.changed(name); }
            }
        }
    }
}

export component InputPage inherits Rectangle {
    in property <bool> independent-pointers-enabled: false;
    callback independent-pointers-toggled(bool);
    in property <bool> hop-bypass-enabled: false;
    in property <bool> multi-hop-enabled: false;
    callback multi-hop-toggled(bool);
    callback hop-bypass-toggled(bool);
    in property <[string]> capture-backends;
    in property <[string]> emulation-backends;
    in property <string> capture-backend-choice;
    in property <string> emulation-backend-choice;
    callback capture-backend-changed(string);
    callback emulation-backend-changed(string);
    background: Theme.background;
    PageScroll {
        Text { text: Translations.tr("navigation-input"); color: Theme.text; font-size: Theme.title-size; wrap: word-wrap; }
        Text { text: Translations.tr("input-description"); color: Theme.muted-text; font-size: Theme.body-size; wrap: word-wrap; }
        if root.capture-backends.length > 0: BackendChoice {
            title: Translations.tr("input-capture-backend");
            backends: root.capture-backends;
            choice: root.capture-backend-choice;
            changed(name) => { root.capture-backend-changed(name); }
        }
        if root.emulation-backends.length > 0: BackendChoice {
            title: Translations.tr("input-emulation-backend");
            backends: root.emulation-backends;
            choice: root.emulation-backend-choice;
            changed(name) => { root.emulation-backend-changed(name); }
        }
        if root.capture-backends.length > 0: Text {
            text: Translations.tr("input-backend-description");
            color: Theme.muted-text;
            font-size: Theme.caption-size;
            wrap: word-wrap;
        }
        SettingRow {
            title: Translations.tr("input-independent-pointers");
            description: Translations.tr("input-independent-pointers-description");
            enabled: root.independent-pointers-enabled;
            toggled(value) => { root.independent-pointers-toggled(value); }
        }
        SettingRow {
            title: Translations.tr("input-multi-hop");
            description: Translations.tr("input-multi-hop-description");
            enabled: root.multi-hop-enabled;
            toggled(value) => { root.multi-hop-toggled(value); }
        }
        SettingRow {
            title: Translations.tr("input-hop-bypass");
            description: Translations.tr("input-hop-bypass-description");
            enabled: root.hop-bypass-enabled;
            toggled(value) => { root.hop-bypass-toggled(value); }
        }
    }
}
