import { LineEdit, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../localization.slint";
import { AppButton } from "../components/controls.slint";
import { ClientItem } from "../components/client-row.slint";

// One mouse button of the drawn mouse. Pressing it holds the remote button
// down until release, so drag-and-drop works as on a real mouse.
component MouseButton inherits Rectangle {
    in property <bool> enabled;
    in property <string> label;
    in property <length> radius-left;
    in property <length> radius-right;
    callback press();
    callback release();
    border-top-left-radius: root.radius-left;
    border-top-right-radius: root.radius-right;
    background: area.pressed ? Theme.accent.with-alpha(0.30) : Theme.elevated-surface;
    animate background { duration: 80ms; }
    Text {
        text: root.label;
        color: Theme.muted-text;
        font-size: Theme.caption-size;
        horizontal-alignment: center;
        vertical-alignment: bottom;
        y: parent.height - self.height - 10px;
        width: parent.width;
    }
    area := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.press(); }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.release(); }
        }
    }
}

// Compact square key with an icon; the label is for screen readers.
component KeyButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback pressed();
    width: 48px;
    height: 48px;
    border-radius: Theme.small-radius;
    background: touch.pressed ? Theme.accent.with-alpha(0.3) : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.pressed(); }
    Image { source: root.icon; colorize: Theme.text; width: 24px; height: 24px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.pressed(); } }
}

// The phone as a mouse and keyboard for one of the paired computers.
// The mouse is drawn as a mouse: two buttons at the top, a wheel between
// them that turns as you drag it, and the body as the touch surface.
export component TouchpadPage inherits Rectangle {
    in property <[ClientItem]> clients;
    in-out property <int> target: 0;
    // Pointer speed multiplier, like a mouse's DPI.
    in-out property <float> sensitivity: 2.5;
    callback begin(int);
    callback motion(int, float, float);
    callback button(int, int, bool);
    callback scroll(int, float);
    callback type-text(int, string);
    callback backspace(int);
    callback enter(int);

    private property <bool> has-target: root.clients.length > 0 && root.target < root.clients.length;
    private property <int> zone: root.has-target ? root.clients[root.target].position : 0;
    private property <bool> ready: root.has-target && root.clients[root.target].alive;
    // Turn of the drawn wheel, following the scroll drags.
    private property <angle> wheel-turn: 0deg;
    // A zero-width placeholder keeps the text field non-empty, so the
    // keyboard's delete key has something to remove and can be detected.
    private property <string> sentinel: "\u{200B}";

    background: Theme.background;

    VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.small-spacing;

        if root.clients.length == 0: Text {
            text: Translations.tr("touchpad-no-devices");
            color: Theme.muted-text;
            font-size: Theme.body-size;
            wrap: word-wrap;
            vertical-stretch: 0;
        }

        if root.clients.length > 0: HorizontalLayout {
            spacing: Theme.small-spacing;
            alignment: start;
            vertical-stretch: 0;
            for client[index] in root.clients: Rectangle {
                height: 36px;
                width: chip-text.preferred-width + 28px;
                border-radius: 18px;
                background: index == root.target ? Theme.accent.with-alpha(0.22) : Theme.surface;
                border-width: 1px;
                border-color: index == root.target ? Theme.accent : Theme.border;
                chip-text := Text {
                    text: (client.alive ? "● " : "○ ") + client.display-name;
                    color: index == root.target ? Theme.text : Theme.muted-text;
                    font-size: Theme.body-size;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea { clicked => { root.target = index; } }
            }
        }

        if root.has-target: HorizontalLayout {
            spacing: Theme.small-spacing;
            vertical-stretch: 0;
            Text { text: Translations.tr("touchpad-speed"); color: Theme.muted-text; font-size: Theme.caption-size; vertical-alignment: center; }
            Slider { horizontal-stretch: 1; minimum: 0.5; maximum: 6; value <=> root.sensitivity; }
            Text { text: round(root.sensitivity * 10) / 10 + "×"; color: Theme.text; font-size: Theme.caption-size; vertical-alignment: center; width: 36px; }
        }
        if root.has-target && !root.ready: Text {
            text: Translations.tr("touchpad-offline");
            color: Theme.warning;
            font-size: Theme.caption-size;
            wrap: word-wrap;
            vertical-stretch: 0;
        }

        // The mouse.
        mouse := Rectangle {
            vertical-stretch: 1;
            private property <length> buttons-height: min(150px, self.height * 0.28);
            private property <length> wheel-width: 34px;
            border-top-left-radius: self.width / 2.4;
            border-top-right-radius: self.width / 2.4;
            border-bottom-left-radius: self.width / 3;
            border-bottom-right-radius: self.width / 3;
            clip: true;
            background: Theme.surface;
            border-width: 1px;
            border-color: body.pressed || mouse.dragging ? Theme.accent : Theme.border;
            // Held left button started by a long press, released on lift.
            private property <bool> dragging: false;
            private property <length> last-x;
            private property <length> last-y;
            private property <length> press-x;
            private property <length> press-y;
            private property <bool> travelled: false;

            MouseButton {
                x: 0; y: 0;
                width: (parent.width - mouse.wheel-width) / 2;
                height: mouse.buttons-height;
                radius-left: parent.width / 2.4;
                enabled: root.has-target;
                label: Translations.tr("touchpad-left");
                press => { root.begin(root.zone); root.button(root.zone, 0, true); }
                release => { root.button(root.zone, 0, false); }
            }
            MouseButton {
                x: (parent.width + mouse.wheel-width) / 2; y: 0;
                width: (parent.width - mouse.wheel-width) / 2;
                height: mouse.buttons-height;
                radius-right: parent.width / 2.4;
                enabled: root.has-target;
                label: Translations.tr("touchpad-right");
                press => { root.begin(root.zone); root.button(root.zone, 1, true); }
                release => { root.button(root.zone, 1, false); }
            }
            // The wheel: ridges scroll past as it turns.
            wheel := Rectangle {
                x: (parent.width - self.width) / 2;
                y: 18px;
                width: mouse.wheel-width - 8px;
                height: mouse.buttons-height - 36px;
                border-radius: self.width / 2;
                background: wheel-touch.pressed ? Theme.accent.with-alpha(0.35) : Theme.background;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                for i in [0, 1, 2, 3, 4, 5, 6, 7]: Rectangle {
                    private property <float> phase: mod(i * 0.125 + root.wheel-turn / 360deg, 1.0);
                    x: 4px;
                    width: parent.width - 8px;
                    height: 2px;
                    border-radius: 1px;
                    y: self.phase * parent.height;
                    // Ridges near the ends curve away and fade, like a cylinder.
                    opacity: sin(self.phase * 180deg);
                    background: Theme.muted-text;
                }
                private property <length> last-y;
                wheel-touch := TouchArea {
                    enabled: root.has-target;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { root.begin(root.zone); wheel.last-y = self.mouse-y; }
                    }
                    moved => {
                        let dy = (self.mouse-y - wheel.last-y) / 1px;
                        root.scroll(root.zone, dy);
                        root.wheel-turn += dy * 3deg;
                        wheel.last-y = self.mouse-y;
                    }
                }
            }
            // Seam between the buttons and the body.
            Rectangle { y: mouse.buttons-height; height: 1px; background: Theme.border; }

            Text {
                y: mouse.buttons-height;
                height: parent.height - mouse.buttons-height;
                width: parent.width;
                text: mouse.dragging ? Translations.tr("touchpad-dragging") : Translations.tr("touchpad-hint");
                color: Theme.muted-text.with-alpha(0.6);
                font-size: Theme.caption-size;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            long-press := Timer {
                interval: 450ms;
                running: false;
                triggered => {
                    self.running = false;
                    if body.pressed && !mouse.travelled {
                        mouse.dragging = true;
                        root.button(root.zone, 0, true);
                    }
                }
            }
            body := TouchArea {
                y: mouse.buttons-height;
                height: parent.height - mouse.buttons-height;
                enabled: root.has-target;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.begin(root.zone);
                        mouse.last-x = self.mouse-x; mouse.last-y = self.mouse-y;
                        mouse.press-x = self.mouse-x; mouse.press-y = self.mouse-y;
                        mouse.travelled = false;
                        long-press.running = true;
                    }
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        long-press.running = false;
                        if mouse.dragging {
                            mouse.dragging = false;
                            root.button(root.zone, 0, false);
                        } else if !mouse.travelled && event.kind == PointerEventKind.up {
                            // A tap is a left click.
                            root.button(root.zone, 0, true);
                            root.button(root.zone, 0, false);
                        }
                    }
                }
                moved => {
                    if abs(self.mouse-x - mouse.press-x) + abs(self.mouse-y - mouse.press-y) > 8px {
                        mouse.travelled = true;
                    }
                    root.motion(root.zone, (self.mouse-x - mouse.last-x) / 1px * root.sensitivity, (self.mouse-y - mouse.last-y) / 1px * root.sensitivity);
                    mouse.last-x = self.mouse-x; mouse.last-y = self.mouse-y;
                }
            }
        }

        // One row: type on the computer, delete, enter.
        HorizontalLayout {
            spacing: Theme.small-spacing;
            vertical-stretch: 0;
            keyboard := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: Translations.tr("touchpad-type");
                enabled: root.has-target;
                text: root.sentinel;
                edited(value) => {
                    root.begin(root.zone);
                    if value == "" {
                        // The sentinel was deleted: the user pressed delete.
                        root.backspace(root.zone);
                    } else if value != root.sentinel {
                        root.type-text(root.zone, value);
                    }
                    self.text = root.sentinel;
                }
                accepted => { root.enter(root.zone); }
            }
            KeyButton { icon: @image-url("../assets/shell/backspace.svg"); label: Translations.tr("touchpad-delete"); enabled: root.has-target; pressed => { root.begin(root.zone); root.backspace(root.zone); } }
            KeyButton { icon: @image-url("../assets/shell/enter.svg"); label: Translations.tr("touchpad-enter"); enabled: root.has-target; pressed => { root.begin(root.zone); root.enter(root.zone); } }
        }
    }
}
