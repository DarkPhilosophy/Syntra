import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Translations } from "../localization.slint";
import { Theme } from "../theme.slint";
import { DiagnosticEntry, DiagnosticRow } from "../components/diagnostic-row.slint";
import { AppButton } from "../components/controls.slint";

export component DiagnosticsPage inherits Rectangle {
    in property <[DiagnosticEntry]> entries;
    in property <string> text-filter;
    in property <bool> paused: false;
    in-out property <bool> follow-tail: true;
    in property <bool> compact: false;
    callback text-filter-changed(string);
    callback pause-toggled(bool);
    callback clear-requested();
    callback copy-all();
    callback copy-text(string);
    // Selected record, shown in full below the list where it can be read,
    // selected with the mouse and copied.
    private property <int> selected: -1;
    private property <bool> has-selection: root.selected >= 0 && root.selected < root.entries.length;
    private property <DiagnosticEntry> current: root.has-selection ? root.entries[root.selected] : { };
    private property <string> current-line: root.current.timestamp + "  " + root.current.level + "  " + root.current.stage + "  " + root.current.direction + "  " + root.current.correlation + "  " + root.current.message;
    changed entries => {
        // Rows shift as the tail advances; never point at a different record.
        if root.selected >= root.entries.length { root.selected = -1; }
    }
    background: Theme.background;
    VerticalLayout {
        spacing: Theme.spacing;
        padding: Theme.content-gap;
        Text { text: Translations.tr("navigation-diagnostics"); color: Theme.text; font-size: Theme.title-size; }
        LineEdit {
            placeholder-text: Translations.tr("diagnostics-filter");
            text: root.text-filter;
            edited => { root.text-filter-changed(self.text); }
        }
        // Narrow screens: two rows of controls instead of one that overflows.
        HorizontalLayout {
            spacing: Theme.small-spacing;
            Text { text: root.paused ? Translations.tr("diagnostics-paused") : Translations.tr("diagnostics-live"); color: root.paused ? Theme.warning : Theme.success; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; }
            AppButton { text: root.follow-tail ? Translations.tr("diagnostics-following-tail") : Translations.tr("diagnostics-follow-tail"); clicked => { root.follow-tail = !root.follow-tail; } }
            AppButton { text: root.paused ? Translations.tr("diagnostics-resume") : Translations.tr("diagnostics-pause"); clicked => { root.pause-toggled(!root.paused); } }
            if !root.compact: AppButton { text: Translations.tr("diagnostics-copy-all"); enabled: root.entries.length > 0; clicked => { root.copy-all(); } }
            if !root.compact: AppButton { text: Translations.tr("diagnostics-clear"); clicked => { root.selected = -1; root.clear-requested(); } }
        }
        if root.compact: HorizontalLayout {
            spacing: Theme.small-spacing;
            alignment: end;
            AppButton { text: Translations.tr("diagnostics-copy-all"); enabled: root.entries.length > 0; clicked => { root.copy-all(); } }
            AppButton { text: Translations.tr("diagnostics-clear"); clicked => { root.selected = -1; root.clear-requested(); } }
        }
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            DiagnosticRow {
                header: true;
                compact: root.compact;
                entry: { timestamp: Translations.tr("diagnostics-column-time"), level: Translations.tr("diagnostics-filter-level"), stage: Translations.tr("diagnostics-filter-stage"), direction: Translations.tr("diagnostics-filter-direction"), correlation: Translations.tr("diagnostics-column-event"), message: Translations.tr("diagnostics-column-message") };
            }
            ListView {
                mouse-drag-pan-enabled: Theme.touch-input-active || !Theme.desktop-platform;
                vertical-stretch: 1;
                changed viewport-height => {
                    if root.follow-tail { self.viewport-y = min(0px, self.visible-height - self.viewport-height); }
                }
                for entry[index] in root.entries: DiagnosticRow {
                    width: parent.width;
                    entry: entry;
                    compact: root.compact;
                    selected: index == root.selected;
                    clicked => {
                        root.selected = root.selected == index ? -1 : index;
                        // Reading a record must not be yanked away by new ones.
                        if root.selected >= 0 { root.follow-tail = false; }
                    }
                }
            }
        }
        if root.has-selection: Rectangle {
            height: min(220px, detail.preferred-height + 2 * Theme.small-spacing);
            vertical-stretch: 0;
            background: Theme.surface;
            border-radius: Theme.corner-radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.small-spacing;
                spacing: Theme.small-spacing;
                HorizontalLayout {
                    spacing: Theme.small-spacing;
                    Text {
                        horizontal-stretch: 1;
                        text: root.current.timestamp + " · " + root.current.level + " · " + root.current.stage;
                        color: Theme.muted-text;
                        font-size: Theme.caption-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    AppButton { text: Translations.tr("diagnostics-copy"); clicked => { root.copy-text(root.current-line); } }
                    AppButton { text: Translations.tr("action-close"); clicked => { root.selected = -1; } }
                }
                ScrollView {
                    detail := TextInput {
                        text: root.current.message;
                        read-only: true;
                        single-line: false;
                        wrap: word-wrap;
                        color: Theme.text;
                        selection-background-color: Theme.accent.with-alpha(0.35);
                        font-family: "monospace";
                        font-size: Theme.body-size;
                    }
                }
            }
        }
    }
}
