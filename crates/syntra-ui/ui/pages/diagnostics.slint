import { LineEdit, ComboBox, ScrollView, ListView } from "std-widgets.slint";
import { Translations } from "../localization.slint";

import { Theme } from "../theme.slint";
import { DiagnosticEntry, DiagnosticRow, DiagnosticColumns } from "../components/diagnostic-row.slint";
import { AppButton } from "../components/controls.slint";

export component DiagnosticsPage inherits Rectangle {
    in property <[DiagnosticEntry]> entries;
    in property <int> message-columns: 80;
    in property <string> selected-level: "all";
    in property <string> selected-stage: "all";
    in property <string> selected-direction: "all";
    in property <string> text-filter;
    in property <bool> paused: false;
    in-out property <bool> follow-tail: true;
    in property <bool> compact: false;
    in property <int> visible-count: entries.length;
    callback level-filter-changed(string);
    callback stage-filter-changed(string);
    callback direction-filter-changed(string);
    callback text-filter-changed(string);
    callback pause-toggled(bool);
    callback clear-requested();
    callback follow-tail-toggled(bool);

    background: Theme.background;
    vertical-stretch: 1;

    VerticalLayout {
        spacing: Theme.spacing;
        padding: Theme.content-gap;
        HorizontalLayout {
            spacing: Theme.small-spacing;
            Text { text: Translations.tr("navigation-diagnostics"); color: Theme.text; font-size: Theme.title-size; vertical-alignment: center; horizontal-stretch: 1; }
            LineEdit { width: 0px; horizontal-stretch: 1; placeholder-text: Translations.tr("diagnostics-filter"); text: text-filter; edited => { root.text-filter-changed(self.text); } }
        }
        HorizontalLayout {
            spacing: Theme.small-spacing;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: Translations.tr("diagnostics-filter-level"); color: Theme.muted-text; font-size: Theme.caption-size; }
                    ComboBox {
                        width: 0px;
                        horizontal-stretch: 1;
                        model: [Translations.tr("diagnostics-all-levels"), Translations.tr("diagnostics-level-info"), Translations.tr("diagnostics-level-warning"), Translations.tr("diagnostics-level-error")];
                        current-index: selected-level == "all" ? 0 : selected-level == "info" ? 1 : selected-level == "warning" ? 2 : 3;
                        selected(value) => { root.level-filter-changed(self.current-index == 0 ? "all" : self.current-index == 1 ? "info" : self.current-index == 2 ? "warning" : "error"); }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: Translations.tr("diagnostics-filter-stage"); color: Theme.muted-text; font-size: Theme.caption-size; }
                    ComboBox {
                        width: 0px;
                        horizontal-stretch: 1;
                        model: [Translations.tr("diagnostics-all-stages"), Translations.tr("diagnostics-stage-capture"), Translations.tr("diagnostics-stage-network"), Translations.tr("diagnostics-stage-clipboard"), Translations.tr("diagnostics-stage-authorization")];
                        current-index: selected-stage == "all" ? 0 : selected-stage == "capture" ? 1 : selected-stage == "network" ? 2 : selected-stage == "clipboard" ? 3 : 4;
                        selected(value) => { root.stage-filter-changed(self.current-index == 0 ? "all" : self.current-index == 1 ? "capture" : self.current-index == 2 ? "network" : self.current-index == 3 ? "clipboard" : "authorization"); }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: Translations.tr("diagnostics-filter-direction"); color: Theme.muted-text; font-size: Theme.caption-size; }
                    ComboBox {
                        width: 0px;
                        horizontal-stretch: 1;
                        model: [Translations.tr("diagnostics-all-directions"), Translations.tr("diagnostics-direction-local"), Translations.tr("diagnostics-direction-incoming"), Translations.tr("diagnostics-direction-outgoing")];
                        current-index: selected-direction == "all" ? 0 : selected-direction == "local" ? 1 : selected-direction == "incoming" ? 2 : 3;
                        selected(value) => { root.direction-filter-changed(self.current-index == 0 ? "all" : self.current-index == 1 ? "local" : self.current-index == 2 ? "incoming" : "outgoing"); }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 30px;
            spacing: Theme.small-spacing;
            Text { text: paused ? Translations.tr("diagnostics-paused") : Translations.tr("diagnostics-live"); color: paused ? Theme.warning : Theme.success; font-size: Theme.body-size; vertical-alignment: center; horizontal-stretch: 1; }
            Text { text: "\{visible-count} events"; color: Theme.muted-text; font-size: Theme.body-size; vertical-alignment: center; }
            AppButton { text: follow-tail ? Translations.tr("diagnostics-following-tail") : Translations.tr("diagnostics-follow-tail"); clicked => { root.follow-tail = !root.follow-tail; } }
            AppButton { text: paused ? Translations.tr("diagnostics-resume") : Translations.tr("diagnostics-pause"); clicked => { root.pause-toggled(!paused); } }
            AppButton { text: Translations.tr("diagnostics-clear"); clicked => { root.clear-requested(); } }
        }
        horizontal-scroll := ScrollView {
            vertical-stretch: 1;
            // The message column is sized from the longest message, but a
            // single long line must not stretch the table to tens of
            // thousands of pixels: past this the column scrolls instead.
            property <length> message-width: clamp(
                root.message-columns * Theme.body-size * 0.55,
                240px,
                1600px
            );
            viewport-width: max(self.visible-width, DiagnosticColumns.fixed-width + self.message-width);
            viewport-height: self.visible-height;
            contents := VerticalLayout {
                width: horizontal-scroll.viewport-width;
                height: horizontal-scroll.viewport-height;
                spacing: 0px;
                DiagnosticRow {
                    header: true;
                    message-width: horizontal-scroll.message-width;
                    entry: { timestamp: Translations.tr("diagnostics-column-time"), level: Translations.tr("diagnostics-filter-level"), stage: Translations.tr("diagnostics-filter-stage"), direction: Translations.tr("diagnostics-filter-direction"), correlation: Translations.tr("diagnostics-column-event"), message: Translations.tr("diagnostics-column-message") };
                }
                ListView {
                    // ListView virtualises: only rows inside the viewport are
                    // instantiated. A plain layout built every row, so a few
                    // hundred entries were laid out on every update and the
                    // page stuttered no matter how little had changed.
                    vertical-stretch: 1;
                    for entry in entries: DiagnosticRow {
                        width: horizontal-scroll.viewport-width;
                        entry: entry;
                        compact: root.compact;
                        message-width: horizontal-scroll.message-width;
                    }
                }
            }
        }
    }
}
