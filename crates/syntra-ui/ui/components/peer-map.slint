import { Theme } from "../theme.slint";
import { Translations } from "../localization.slint";
import { ClientItem } from "client-row.slint";
import { Avatar } from "avatar.slint";

export component PeerMap inherits Rectangle {
    in property <bool> mobile;
    in property <[ClientItem]> clients;
    in property <int> zone-depth: 1;
    in property <string> local-name;
    in property <image> local-image;
    in property <bool> has-local-image;
    callback move-peer(string, int);
    // A device is being dragged: the page must not scroll under the finger.
    out property <bool> dragging: false;
    // Keep the diagram readable at a glance while leaving room for names.
    private property <length> avatar-size: root.mobile ? 32px : 56px;
    private property <length> header-height: root.mobile ? 20px : 28px;
    private property <length> row-height: root.avatar-size + Theme.body-size * 1.5 + 3 * Theme.small-spacing;
    private property <length> avatar-top: root.header-height + Theme.small-spacing;
    private property <length> local-content-height: root.avatar-size + Theme.small-spacing + Theme.body-size * 1.5;
    private property <length> lane: root.mobile ? max(root.width / 3, max(1, root.zone-depth) * root.row-height + root.header-height + Theme.small-spacing) : max(128px, max(1, root.zone-depth) * root.row-height + root.header-height + Theme.small-spacing);
    height: 3 * root.lane + 2 * Theme.small-spacing;
    vertical-stretch: 0;
    for zone in [0, 1, 2, 3]: Rectangle {
        x: zone == 0 ? 0px : zone == 1 ? 2 * parent.width / 3 : parent.width / 3;
        y: zone == 2 ? 0px : zone == 3 ? 2 * root.lane : root.lane;
        width: parent.width / 3 - Theme.small-spacing;
        height: root.lane - Theme.small-spacing;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.small-radius;
        Text { x: 8px; y: 8px; width: max(0px, parent.width - 16px); text: Translations.tr(zone == 0 ? "position-left" : zone == 1 ? "position-right" : zone == 2 ? "position-top" : "position-bottom"); color: Theme.muted-text; font-size: Theme.caption-size; horizontal-alignment: right; overflow: elide; }
    }
    local-card := Rectangle {
        x: parent.width / 3;
        y: root.lane;
        width: parent.width / 3 - Theme.small-spacing;
        height: root.lane - Theme.small-spacing;
        background: Theme.elevated-surface;
        border-radius: Theme.small-radius;
        // Reserves the same label band the surrounding zones use, even
        // though this card carries no direction label, so its group lines up
        // with theirs instead of sitting a half-band higher.
        // `self`, not `parent`: inside a property declaration `parent` is the
        // map, whose height spans all three lanes, which pushed the group a
        // lane and a half down into the bottom zone.
        private property <length> group-top:
            root.header-height + (self.height - root.header-height - root.local-content-height) / 2;
        Avatar {
            source: root.local-image; has-image: root.has-local-image;
            size: root.avatar-size;
            width: root.avatar-size;
            height: root.avatar-size;
            x: (parent.width - root.avatar-size) / 2;
            y: local-card.group-top;
        }
        Text {
            x: Theme.small-spacing;
            y: local-card.group-top + root.avatar-size + Theme.small-spacing;
            width: max(0px, parent.width - 2 * Theme.small-spacing);
            height: Theme.body-size * 1.5;
            text: root.local-name; color: Theme.text;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        }
    }
    // Handle of the device picked up by a tap on phones ("" when none).
    in-out property <string> picked: "";
    // Drop zones for a picked or dragged device.
    for zone[index] in [0, 1, 2, 3]: Rectangle {
        visible: !Theme.desktop-platform && (root.picked != "" || root.dragging);
        x: zone == 0 ? 0px : zone == 1 ? 2 * root.width / 3 : root.width / 3;
        y: zone == 2 ? 0px : zone == 3 ? 2 * root.lane : root.lane;
        width: root.width / 3;
        height: root.lane;
        border-radius: Theme.small-radius;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.6);
        background: Theme.accent.with-alpha(0.06);
        TouchArea {
            clicked => {
                root.move-peer(root.picked, zone);
                root.picked = "";
            }
        }
    }
    for peer in root.clients: card := Rectangle {
        // The direction label occupies a band at the top of every zone, so
        // the peers below it are centred within what remains. Without this
        // the stack sat flush under the label and read as too low.
        private property <length> zone-content: root.lane - Theme.small-spacing - root.header-height;
        private property <length> stack-height: max(1, peer.zone-total) * root.row-height;
        private property <length> home-x: peer.position == 0 ? 0px : peer.position == 1 ? 2 * root.width / 3 : root.width / 3;
        private property <length> home-y: (peer.position == 2 ? 0px : peer.position == 3 ? 2 * root.lane : root.lane)
            + root.header-height
            + max(0px, (self.zone-content - self.stack-height) / 2)
            + peer.zone-index * root.row-height;
        private property <length> press-x;
        private property <length> press-y;
        // Phones: holding a device picks it up for dragging; a quick swipe
        // stays the page scroll, a tap picks it for tap-to-move.
        private property <bool> held: false;
        private property <bool> moved: false;
        hold := Timer {
            interval: 250ms;
            running: false;
            triggered => {
                self.running = false;
                parent.held = true;
                root.dragging = true;
                root.picked = "";
            }
        }
        x: home-x;
        y: home-y;
        width: root.width / 3 - Theme.small-spacing;
        height: root.row-height;
        background: drag.pressed && (Theme.desktop-platform || self.held) ? Theme.selection : transparent;
        border-radius: Theme.small-radius;
        border-width: drag.pressed && (Theme.desktop-platform || self.held) ? 1px : 0px;
        border-color: Theme.accent;
        // Identical treatment to the centre card: the avatar is centred with
        // the name directly below it, the pair centred as a group.
        //
        // Positioned explicitly rather than through a layout, and with an
        // explicit height, because `Avatar` declares only a minimum height
        // and would otherwise fill the card and re-centre its own circle.
        Avatar {
            source: peer.custom-image; has-image: peer.has-custom-image;
            size: root.avatar-size;
            width: root.avatar-size;
            height: root.avatar-size;
            x: (parent.width - root.avatar-size) / 2;
            y: (parent.height - root.local-content-height) / 2;
        }
        Text {
            x: Theme.small-spacing;
            y: (parent.height - root.local-content-height) / 2
                + root.avatar-size + Theme.small-spacing;
            width: max(0px, parent.width - 2 * Theme.small-spacing);
            height: Theme.body-size * 1.5;
            text: peer.display-name; color: Theme.text;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide;
        }
        if !Theme.desktop-platform && root.picked == peer.handle: Rectangle {
            border-width: 2px;
            border-color: Theme.accent;
            border-radius: Theme.small-radius;
            background: Theme.accent.with-alpha(0.12);
        }
        drag := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    parent.press-x = self.mouse-x;
                    parent.press-y = self.mouse-y;
                    parent.moved = false;
                    if !Theme.desktop-platform { hold.running = true; }
                }
                if event.kind == PointerEventKind.move
                    && abs(self.mouse-x - parent.press-x) + abs(self.mouse-y - parent.press-y) > 10px {
                    parent.moved = true;
                    // Moving before the hold completes is a scroll, not a drag.
                    if !parent.held { hold.running = false; }
                }
                if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    hold.running = false;
                    let was-held = parent.held;
                    parent.held = false;
                    root.dragging = false;
                    if event.kind == PointerEventKind.cancel { return; }
                    if !Theme.desktop-platform && !was-held && !parent.moved {
                        root.picked = root.picked == peer.handle ? "" : peer.handle;
                        return;
                    }
                    // Coordinates stay relative to the stable card, not the drag preview.
                    let px = parent.home-x + self.mouse-x;
                    let py = parent.home-y + self.mouse-y;
                    if (Theme.desktop-platform || was-held) && abs(self.mouse-x - parent.press-x) + abs(self.mouse-y - parent.press-y) > 6px {
                        if px >= 0px && px < root.width && py >= 0px && py < root.height {
                            if py < root.lane && px >= root.width / 3 && px < 2 * root.width / 3 { root.move-peer(peer.handle, 2); }
                            else if py >= 2 * root.lane && px >= root.width / 3 && px < 2 * root.width / 3 { root.move-peer(peer.handle, 3); }
                            else if py >= root.lane && py < 2 * root.lane && px < root.width / 3 { root.move-peer(peer.handle, 0); }
                            else if py >= root.lane && py < 2 * root.lane && px >= 2 * root.width / 3 { root.move-peer(peer.handle, 1); }
                        }
                    }
                }
            }
        }
        if drag.pressed && (Theme.desktop-platform || card.held): Rectangle {
            x: drag.mouse-x - parent.press-x;
            y: drag.mouse-y - parent.press-y;
            width: parent.width;
            height: parent.height;
            background: Theme.accent.with-alpha(0.25);
            border-width: 2px;
            border-color: Theme.accent;
            border-radius: Theme.small-radius;
        }
    }
}
