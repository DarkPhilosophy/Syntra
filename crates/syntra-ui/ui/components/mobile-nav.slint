import { Theme } from "../theme.slint";
import { NavEntry } from "navigation.slint";

// Phone header: the mark and the name of the current page. Window controls
// do not exist on a phone, so there is nothing else to show.
export component MobileTopBar inherits Rectangle {
    in property <string> title;
    in property <bool> can-go-back;
    callback back();
    in property <string> back-label;
    height: 56px;
    background: Theme.sidebar;
    HorizontalLayout {
        padding-left: Theme.spacing;
        padding-right: Theme.spacing;
        spacing: Theme.small-spacing;
        if root.can-go-back: Rectangle { width: 40px; accessible-role: button; accessible-label: "Back"; accessible-action-default => { root.back(); } Text { text: "‹"; color: Theme.text; font-size: 32px; vertical-alignment: center; horizontal-alignment: center; } TouchArea { clicked => { root.back(); } } }
        if !root.can-go-back: Image {
            source: @image-url("../assets/shell/syntra.svg");
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

// Thumb-reachable primary destinations.
export component MobileBottomNav inherits Rectangle {
    in property <[NavEntry]> tabs;
    in property <string> selected;
    callback activate(string);
    private property <int> active-index: root.selected == "overview" ? 0 : root.selected == "devices" ? 1 : root.selected == "clipboard" ? 2 : root.selected == "transfers" ? 3 : 4;

    height: 64px;
    background: Theme.sidebar;
    Rectangle { height: 1px; y: 0; background: Theme.border; }
    Rectangle { y: 0; x: root.active-index * root.width / 5; width: root.width / 5; height: 3px; background: Theme.accent; animate x { duration: Theme.motion-enabled ? 180ms : 0ms; easing: ease-in-out; } }
    HorizontalLayout {
        for item in root.tabs: Rectangle {
            private property <bool> active: root.selected == item.id;
            accessible-role: button;
            accessible-label: item.label;
            accessible-action-default => { root.activate(item.id); }
            TouchArea { clicked => { root.activate(item.id); } }
            Rectangle {
                y: 8px;
                x: (parent.width - self.width) / 2;
                width: 56px;
                height: 30px;
                border-radius: 15px;
                background: parent.active ? Theme.accent.with-alpha(0.18) : transparent;
                animate background { duration: Theme.motion-enabled ? 150ms : 0ms; }
                Image {
                    source: item.icon;
                    colorize: root.selected == item.id ? Theme.accent : Theme.muted-text;
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                y: 42px;
                width: parent.width;
                text: item.label;
                color: parent.active ? Theme.text : Theme.muted-text;
                font-size: 11px;
                font-weight: parent.active ? 600 : 400;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}
