import { Translations } from "../localization.slint";
import { Theme } from "../theme.slint";

// One meshing gear of the splash mechanism. Rotation comes from the shared
// clock, so every gear stays in step and none of them depends on a timer.
component Gear inherits Image {
    // Centre relative to the stage centre, in design units.
    in property <float> cx;
    in property <float> cy;
    in property <float> radius;
    in property <int> teeth;
    in property <float> direction: 1;
    in property <float> t;
    in property <float> appear-at;
    in property <length> unit;
    in property <length> stage-x;
    in property <length> stage-y;

    private property <float> grow: clamp((root.t - root.appear-at) / 700, 0, 1);
    // Overshoots slightly before settling, like a part dropping into place.
    private property <float> pop: root.grow <= 0 ? 0 : 1 + 2.2 * pow(root.grow - 1, 3) + 1.2 * pow(root.grow - 1, 2);

    width: (root.radius + 2) * 2 * root.unit * max(0, root.pop);
    height: self.width;
    x: root.stage-x + root.cx * root.unit - self.width / 2;
    y: root.stage-y + root.cy * root.unit - self.height / 2;
    // Meshing gears turn at speeds inversely proportional to their teeth.
    transform-rotation: root.direction * root.t / (root.teeth * 500) * 360deg;
    opacity: clamp(root.grow * 2, 0, 1);
}

// A partial ring sweeping around the mechanism.
component Arc inherits Image {
    in property <float> radius;
    in property <float> width-units;
    in property <float> period;
    in property <float> direction: 1;
    in property <float> t;
    in property <float> appear-at;
    in property <length> unit;
    in property <length> stage-x;
    in property <length> stage-y;
    in property <float> cy;

    width: (root.radius + root.width-units) * 2 * root.unit;
    height: self.width;
    x: root.stage-x - self.width / 2;
    y: root.stage-y + root.cy * root.unit - self.height / 2;
    transform-rotation: root.direction * root.t / root.period * 360deg;
    // Fades in, then breathes so the rings never look pasted on.
    opacity: clamp((root.t - root.appear-at) / 800, 0, 1) * (0.7 + 0.3 * sin(root.t / root.period * 720deg));
}

// Launch splash: a brass-and-steel mechanism turning around the mark, the
// name rising beneath it and the real service state below. The window is
// transparent while it shows, and nothing here paints a background, so only
// the drawing itself appears over the desktop.
export component WelcomeOverlay inherits Rectangle {
    in-out property <bool> launch-visible: true;
    in property <bool> launch-ready: false;
    in property <bool> connected: false;
    in property <string> version;

    private property <duration> origin;
    // Milliseconds since the splash appeared; one clock drives everything.
    private property <float> t: Theme.motion-enabled ? (animation-tick() - root.origin) / 1ms : 100000;
    private property <length> unit: min(1px, min(self.width, self.height) / 620);
    // Mechanism centre.
    private property <length> sx: self.width / 2;
    private property <length> sy: self.height / 2 - 70 * root.unit;

    pure function span(start: float, length: float) -> float {
        return clamp((root.t - start) / length, 0, 1);
    }
    pure function ease-out(x: float) -> float {
        return 1 - pow(1 - x, 3);
    }

    init => { root.origin = animation-tick(); }

    visible: launch-visible;
    background: transparent;
    opacity: launch-ready ? 0 : 1;
    animate opacity { duration: Theme.motion-enabled ? 380ms : 0ms; easing: ease-in; }

    // Swallow input so nothing underneath reacts during the splash.
    TouchArea { width: parent.width; height: parent.height; }

    dismiss-timer := Timer {
        interval: Theme.motion-enabled ? 380ms : 1ms;
        running: root.launch-visible && root.launch-ready;
        triggered => { root.launch-visible = false; }
    }

    Arc { source: @image-url("../assets/splash/arc-outer.svg"); radius: 235; width-units: 7; period: 9000; direction: 1; t: root.t; appear-at: 100; unit: root.unit; stage-x: root.sx; stage-y: root.sy; cy: 0; }
    Arc { source: @image-url("../assets/splash/arc-outer-b.svg"); radius: 235; width-units: 7; period: 9000; direction: 1; t: root.t + 4500; appear-at: 4600; unit: root.unit; stage-x: root.sx; stage-y: root.sy; cy: 0; }
    Arc { source: @image-url("../assets/splash/arc-mid.svg"); radius: 205; width-units: 4; period: 14000; direction: -1; t: root.t; appear-at: 250; unit: root.unit; stage-x: root.sx; stage-y: root.sy; cy: 0; }
    Arc { source: @image-url("../assets/splash/arc-inner.svg"); radius: 175; width-units: 5; period: 6000; direction: 1; t: root.t; appear-at: 400; unit: root.unit; stage-x: root.sx; stage-y: root.sy; cy: 0; }

    // The train: each gear meshes with a neighbour and turns the other way.
    Gear { source: @image-url("../assets/splash/gear-a.svg"); cx: -170; cy: -94; radius: 62; teeth: 18; direction: -1; t: root.t; appear-at: 250; unit: root.unit; stage-x: root.sx; stage-y: root.sy; }
    Gear { source: @image-url("../assets/splash/gear-c.svg"); cx: -128; cy: 144; radius: 38; teeth: 12; direction: 1; t: root.t; appear-at: 550; unit: root.unit; stage-x: root.sx; stage-y: root.sy; }
    Gear { source: @image-url("../assets/splash/gear-d.svg"); cx: 212; cy: -14; radius: 30; teeth: 10; direction: 1; t: root.t; appear-at: 700; unit: root.unit; stage-x: root.sx; stage-y: root.sy; }
    Gear { source: @image-url("../assets/splash/gear-b.svg"); cx: 164; cy: 110; radius: 74; teeth: 22; direction: -1; t: root.t; appear-at: 400; unit: root.unit; stage-x: root.sx; stage-y: root.sy; }
    Gear { source: @image-url("../assets/splash/gear-main.svg"); cx: 0; cy: 0; radius: 122; teeth: 36; direction: 1; t: root.t; appear-at: 0; unit: root.unit; stage-x: root.sx; stage-y: root.sy; }

    mark := Image {
        source: @image-url("../assets/shell/syntra.svg");
        private property <float> grow: span(350, 800);
        private property <float> pop: self.grow <= 0 ? 0 : 1 + 2.2 * pow(self.grow - 1, 3) + 1.2 * pow(self.grow - 1, 2);
        width: 150 * root.unit * max(0, self.pop);
        height: self.width;
        x: root.sx - self.width / 2;
        y: root.sy - 8 * root.unit - self.height / 2;
    }

    // Card behind the text only: the mechanism stays free-floating, the
    // words get a quiet surface so they read on any wallpaper.
    Rectangle {
        private property <float> show: ease-out(span(550, 600));
        width: min(root.width - 32px, max(wordmark.preferred-width, 420 * root.unit) + 72 * root.unit);
        height: 168 * root.unit;
        x: (root.width - self.width) / 2;
        y: wordmark.y - 18 * root.unit + (1 - self.show) * 12px;
        border-radius: 22px;
        background: Theme.background.with-alpha(0.78);
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.28);
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000080;
        opacity: self.show;
    }

    // Wordmark: letters rise into place one after another. The Y is drawn
    // as the mark's two horns, the only accented letter, echoing the logo.
    wordmark := HorizontalLayout {
        y: root.sy + 262 * root.unit;
        x: 0;
        width: root.width;
        height: 76 * root.unit;
        alignment: center;
        spacing: 12 * root.unit;
        for letter[index] in ["S", "Y", "N", "T", "R", "A"]: Rectangle {
            private property <float> show: ease-out(span(700 + index * 80, 600));
            width: index == 1 ? 56 * root.unit : glyph.preferred-width;
            glyph := Text {
                visible: index != 1;
                text: letter;
                color: #eef0d9;
                font-size: 64 * root.unit;
                font-weight: 300;
                opacity: parent.show;
                vertical-alignment: center;
                height: parent.height;
                y: (1 - parent.show) * 26px;
            }
            if index == 1: Image {
                source: @image-url("../assets/splash/y-horns.svg");
                // Cap height of the light face at this size.
                width: parent.width;
                height: 51 * root.unit;
                y: (parent.height - self.height) / 2 + (1 - parent.show) * 26px;
                opacity: parent.show;
            }
        }
    }

    Text {
        private property <float> show: ease-out(span(1200, 700));
        y: wordmark.y + wordmark.height + 4px + (1 - self.show) * 10px;
        x: 24px;
        width: root.width - 48px;
        text: Translations.tr("welcome-motto");
        color: #e8ecd9;
        font-size: 19 * root.unit;
        horizontal-alignment: center;
        wrap: word-wrap;
        opacity: self.show;
    }

    // What the app is actually doing right now.
    Rectangle {
        y: wordmark.y + wordmark.height + 40 * root.unit;
        x: 0;
        width: root.width;
        height: 20px;
        opacity: ease-out(span(1500, 500));
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.connected ? Theme.success : Theme.warning;
                opacity: root.connected ? 1 : 0.45 + 0.55 * (0.5 + 0.5 * sin(root.t * 0.5deg));
            }
            Text {
                text: (root.connected ? Translations.tr("welcome-connected") : Translations.tr("welcome-connecting"))
                    + (root.version != "" ? "  ·  v" + root.version : "");
                color: #d6dcc4;
                font-size: Theme.caption-size;
                vertical-alignment: center;
            }
        }
    }
}
