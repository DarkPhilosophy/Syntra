import { Translations } from "../localization.slint";
import { Theme } from "../theme.slint";

// Launch splash. While it shows, the window background is transparent, so
// only this floating panel is visible over the desktop.
export component WelcomeOverlay inherits Rectangle {
    in-out property <bool> launch-visible: true;
    in property <bool> launch-ready: false;

    // Flips on the first frame so every entrance animation has a start state.
    private property <bool> started: false;
    // Toggles continuously to drive the halo pulse and the progress sweep.
    private property <bool> pulse: false;
    private property <bool> compact: self.width < Theme.compact-breakpoint;
    private property <duration> motion: Theme.motion-enabled ? 1ms : 0ms;

    visible: launch-visible;
    background: transparent;
    opacity: launch-ready ? 0 : 1;
    animate opacity { duration: Theme.motion-enabled ? 380ms : 0ms; easing: ease-in; }

    // Swallow input so nothing underneath reacts during the splash.
    TouchArea { width: parent.width; height: parent.height; }

    start-timer := Timer {
        interval: 16ms;
        running: root.launch-visible && !root.started;
        triggered => { root.started = true; }
    }
    pulse-timer := Timer {
        interval: 900ms;
        running: root.launch-visible && !root.launch-ready && Theme.motion-enabled;
        triggered => { root.pulse = !root.pulse; }
    }
    dismiss-timer := Timer {
        interval: Theme.motion-enabled ? 380ms : 1ms;
        running: root.launch-visible && root.launch-ready;
        triggered => { root.launch-visible = false; }
    }

    panel := Rectangle {
        width: min(parent.width - 32px, root.compact ? 360px : 560px);
        height: min(parent.height - 32px, root.compact ? 380px : 460px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.started ? 0px : 18px);
        border-radius: 32px;
        background: Theme.background.with-alpha(0.82);
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.22);
        drop-shadow-blur: 48px;
        drop-shadow-color: #000000a0;
        opacity: root.started ? 1 : 0;
        animate y, opacity { duration: Theme.motion-enabled ? 520ms : 0ms; easing: ease-out; }

        // Halo behind the mark, breathing while the app loads.
        halo := Rectangle {
            private property <length> size: (root.compact ? 150px : 210px) * (root.pulse ? 1.08 : 0.94);
            width: self.size;
            height: self.size;
            x: (parent.width - self.width) / 2;
            y: mark.y + (mark.height - self.height) / 2;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, Theme.accent.with-alpha(0.30) 0%, Theme.accent.with-alpha(0.08) 55%, transparent 72%);
            opacity: root.started ? (root.pulse ? 1 : 0.65) : 0;
            animate width, height, opacity { duration: Theme.motion-enabled ? 900ms : 0ms; easing: ease-in-out; }
        }

        mark := Image {
            source: @image-url("../assets/shell/syntra.svg");
            private property <length> size: root.compact ? 112px : 152px;
            width: self.size * (root.started ? 1 : 0.82);
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.33 - self.height / 2;
            opacity: root.started ? 1 : 0;
            animate width, opacity { duration: Theme.motion-enabled ? 700ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.2); }
        }

        wordmark := HorizontalLayout {
            y: parent.height * 0.55;
            x: 0;
            width: parent.width;
            height: root.compact ? 52px : 72px;
            alignment: center;
            // The "SY" monogram carries the accent; the rest follows the text
            // color. Kept literal because the wordmark is the brand itself.
            Text {
                text: "SY";
                color: Theme.accent;
                font-size: root.compact ? 44px : 64px;
                font-weight: 800;
                letter-spacing: root.started ? (root.compact ? 6px : 10px) : 28px;
                opacity: root.started ? 1 : 0;
                animate letter-spacing, opacity { duration: Theme.motion-enabled ? 800ms : 0ms; delay: Theme.motion-enabled ? 180ms : 0ms; easing: ease-out; }
            }
            Text {
                text: "NTRA";
                color: Theme.text;
                font-size: root.compact ? 44px : 64px;
                font-weight: 300;
                letter-spacing: root.started ? (root.compact ? 6px : 10px) : 28px;
                opacity: root.started ? 1 : 0;
                animate letter-spacing, opacity { duration: Theme.motion-enabled ? 800ms : 0ms; delay: Theme.motion-enabled ? 180ms : 0ms; easing: ease-out; }
            }
        }

        motto := Text {
            y: wordmark.y + wordmark.height + (root.started ? 6px : 16px);
            x: 24px;
            width: parent.width - 48px;
            text: Translations.tr("welcome-motto");
            color: Theme.muted-text;
            font-size: root.compact ? 15px : 19px;
            horizontal-alignment: center;
            wrap: word-wrap;
            opacity: root.started ? 1 : 0;
            animate y, opacity { duration: Theme.motion-enabled ? 700ms : 0ms; delay: Theme.motion-enabled ? 450ms : 0ms; easing: ease-out; }
        }

        // Indeterminate progress: a short highlight sweeping along a track.
        track := Rectangle {
            width: min(parent.width - 96px, 220px);
            height: 4px;
            x: (parent.width - self.width) / 2;
            y: parent.height - 44px;
            border-radius: 2px;
            background: Theme.accent.with-alpha(0.14);
            clip: true;
            opacity: root.started ? 1 : 0;
            animate opacity { duration: Theme.motion-enabled ? 500ms : 0ms; delay: Theme.motion-enabled ? 600ms : 0ms; }
            Rectangle {
                width: parent.width * 0.35;
                height: parent.height;
                x: root.pulse ? parent.width - self.width : 0px;
                border-radius: 2px;
                background: @linear-gradient(90deg, Theme.accent.with-alpha(0) 0%, Theme.accent 50%, Theme.accent.with-alpha(0) 100%);
                animate x { duration: Theme.motion-enabled ? 900ms : 0ms; easing: ease-in-out; }
            }
        }
    }
}
