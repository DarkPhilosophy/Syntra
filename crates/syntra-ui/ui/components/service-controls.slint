import { Theme } from "../theme.slint";
import { Translations } from "../localization.slint";
import { AppButton, AppSwitch } from "controls.slint";

export component ServiceControls inherits Rectangle {
    in property <bool> supported;
    in property <bool> busy;
    in property <bool> desktop-entry-supported;
    in property <bool> desktop-entry-installed;
    in property <bool> known;
    in property <bool> installed;
    in property <bool> running;
    in property <bool> autostart;
    in property <bool> connected;
    in property <string> error;
    in property <string> source-path;
    in property <string> destination-path;
    in property <bool> destination-customised;
    callback choose-destination();
    callback reset-destination();
    callback action(string);
    private property <string> pending: "";
    private property <bool> copies-binaries: root.pending == "install" || root.pending == "install-desktop-entry";
    background: Theme.surface;
    border-radius: Theme.corner-radius;
    height: contents.preferred-height;
    vertical-stretch: 0;
    contents := VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.small-spacing;
        Text { text: Translations.tr("service-title"); color: Theme.text; font-size: Theme.body-size; font-weight: 600; }
        Text { text: Translations.tr("service-description"); color: Theme.muted-text; font-size: Theme.caption-size; wrap: word-wrap; }
        // The destination is a decision, not a fixed fact: show it and let it
        // be changed, rather than installing somewhere the user never chose.
        VerticalLayout {
            spacing: Theme.small-spacing;
            Text { text: Translations.tr("service-install-location") + ": " + root.destination-path; color: Theme.text; font-size: Theme.caption-size; wrap: word-wrap; }
            Text { text: Translations.tr("service-install-location-hint"); color: Theme.muted-text; font-size: Theme.caption-size; wrap: word-wrap; }
            HorizontalLayout {
                spacing: Theme.small-spacing;
                AppButton { text: Translations.tr("service-install-location-choose"); enabled: !root.busy; clicked => { root.choose-destination(); } }
                if root.destination-customised : AppButton { text: Translations.tr("service-install-location-reset"); enabled: !root.busy; clicked => { root.reset-destination(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Text { text: Translations.tr("service-interface") + ": " + (root.connected ? Translations.tr("status-connected") : Translations.tr("label-offline")); color: Theme.text; font-size: Theme.body-size; }
        if root.known : VerticalLayout {
            spacing: Theme.small-spacing;
            Text { text: Translations.tr("service-installation") + ": " + Translations.tr(root.installed ? "service-installed" : "service-not-installed"); color: Theme.text; font-size: Theme.body-size; }
            Text { text: Translations.tr("service-process") + ": " + Translations.tr(root.running ? "service-running" : "service-stopped"); color: root.running ? Theme.success : Theme.muted-text; font-size: Theme.body-size; }
            HorizontalLayout {
                Text { text: Translations.tr("service-autostart"); color: Theme.text; font-size: Theme.body-size; horizontal-stretch: 1; vertical-alignment: center; }
                AppSwitch { checked: root.autostart; enabled: root.installed && !root.busy; a11y-label: Translations.tr("service-autostart"); toggled(value) => { root.pending = value ? "enable" : "disable"; } }
            }
        }
        if root.supported : HorizontalLayout {
            spacing: Theme.small-spacing;
            AppButton { text: Translations.tr("service-refresh"); enabled: !root.busy; clicked => { root.action("refresh"); } }
            if root.known : AppButton { text: Translations.tr(root.installed ? "service-uninstall" : "service-install"); enabled: !root.busy && !root.running; clicked => { root.pending = root.installed ? "uninstall" : "install"; } }
        }
        if root.supported && root.known && root.installed : HorizontalLayout {
            spacing: Theme.small-spacing;
            AppButton { text: Translations.tr("service-start"); enabled: !root.busy && !root.running; clicked => { root.pending = "start"; } }
            AppButton { text: Translations.tr("service-stop"); enabled: !root.busy && root.running; clicked => { root.pending = "stop"; } }
        }
        // The launcher entry is separate from the background service: this
        // one puts the application in the menu and gives its window an icon,
        // it does not start anything at login.
        if root.desktop-entry-supported : VerticalLayout {
            spacing: Theme.small-spacing;
            Text { text: Translations.tr("desktop-entry-title"); color: Theme.text; font-size: Theme.body-size; font-weight: 600; }
            Text { text: Translations.tr("desktop-entry-description"); color: Theme.muted-text; font-size: Theme.caption-size; wrap: word-wrap; }
            Text { text: Translations.tr("desktop-entry-state") + ": " + Translations.tr(root.desktop-entry-installed ? "service-installed" : "service-not-installed"); color: Theme.text; font-size: Theme.body-size; }
            HorizontalLayout {
                spacing: Theme.small-spacing;
                AppButton {
                    text: Translations.tr(root.desktop-entry-installed ? "desktop-entry-remove" : "desktop-entry-install");
                    enabled: !root.busy;
                    clicked => { root.pending = root.desktop-entry-installed ? "remove-desktop-entry" : "install-desktop-entry"; }
                }
            }
        }
        if !root.supported : Text { text: Translations.tr("service-unsupported"); color: Theme.muted-text; wrap: word-wrap; }
        if root.error != "" : Text { text: root.error; color: Theme.danger; wrap: word-wrap; }
        if root.pending != "" : VerticalLayout {
            spacing: Theme.small-spacing;
            Text { text: Translations.tr("service-confirm") + " " + Translations.tr(root.pending == "install-desktop-entry" ? "desktop-entry-install" : root.pending == "remove-desktop-entry" ? "desktop-entry-remove" : "service-" + root.pending); color: Theme.warning; font-size: Theme.body-size; wrap: word-wrap; }
            if root.copies-binaries : Text { text: Translations.tr("service-confirm-source") + ": " + root.source-path; color: Theme.text; font-size: Theme.caption-size; wrap: word-wrap; }
            if root.copies-binaries : Text { text: Translations.tr("service-confirm-destination") + ": " + root.destination-path; color: Theme.text; font-size: Theme.caption-size; wrap: word-wrap; }
            Text { text: Translations.tr((root.pending == "install-desktop-entry" || root.pending == "remove-desktop-entry") ? "desktop-entry-confirm-" + root.pending : "service-confirm-" + root.pending); color: Theme.muted-text; font-size: Theme.caption-size; wrap: word-wrap; }
            HorizontalLayout {
                spacing: Theme.small-spacing;
                AppButton { text: Translations.tr("action-cancel"); clicked => { root.pending = ""; } }
                AppButton { text: Translations.tr("action-confirm"); primary: true; enabled: !root.busy; clicked => { root.action(root.pending); root.pending = ""; } }
            }
        }
    }
}
