import { Theme } from "../theme.slint";
import { AppSwitch } from "controls.slint";
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> interactive: true;
    in-out property <bool> enabled: true;
    callback toggled(bool);
    height: max(Theme.row-height, row.preferred-height);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: Theme.surface; border-radius: Theme.small-radius; border-width: Theme.border-width; border-color: Theme.border;
    opacity: root.interactive ? 1 : 0.55;
    row := HorizontalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;
        VerticalLayout {
            spacing: Theme.small-spacing;
            Text { text: root.title; color: Theme.text; font-size: Theme.body-size; wrap: word-wrap; }
            if root.description != "": Text { text: root.description; color: Theme.muted-text; font-size: Theme.caption-size; wrap: word-wrap; }
        }
        AppSwitch { enabled: root.interactive; checked: root.enabled; a11y-label: root.title; toggled(value) => { root.toggled(value); } }
    }
}
